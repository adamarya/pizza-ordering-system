# Copy this file to server/.env and fill in local values. Never commit .env.
# PostgreSQL connection for local development (matches docker-compose.yml).
DATABASE_URL=postgresql://pizza:pizza@localhost:5432/pizza?schema=public

# Port the API listens on. The client dev server proxies /api and /health here.
PORT=3000

# development | test | production
NODE_ENV=development

# Stripe test keys are added in Sprint 2 (PB-07). Leave blank in Sprint 1.
STRIPE_SECRET_KEY=
