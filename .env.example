# Copy this file to server/.env and fill in local values. Never commit .env.
# PostgreSQL connection for local development (matches docker-compose.yml).
DATABASE_URL=postgresql://pizza:pizza@localhost:5432/pizza?schema=public

# Port the API listens on. The client dev server proxies /api and /health here.
PORT=3000

# development | test | production
NODE_ENV=development

# Stripe sandbox keys (PB-07). Leave blank to run without online payment. Live keys are refused.
# Use a restricted key (rk_test_...) with write access to PaymentIntents rather than a full secret key.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...). Public by design; the browser uses it to load the card fields.
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (whsec_...). For local testing: stripe listen --forward-to localhost:3000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=
